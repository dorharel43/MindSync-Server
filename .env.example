# Copy this file to .env and fill in the values. Never commit .env itself.

# MongoDB connection string (MongoDB Atlas or a local instance).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mindsync

# Secret used to sign JWT auth tokens. Use a long random string, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. The hosting platform usually injects its own.
PORT=5000

# Optional. Comma-separated CORS allow-list for browser clients.
# ALLOWED_ORIGINS=https://example.com,http://localhost:5173

# ---- Web version (see WEB-SETUP.md) ----
# AI runs on the server with this key (enable billing on it before going public).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Daily AI allowance per user: heavy = summary/questions/syllabus, light = short jobs.
# AI_DAILY_HEAVY=15
# AI_DAILY_LIGHT=150
# Uploads (stored in MongoDB GridFS).
# UPLOAD_MAX_MB=20
# UPLOAD_USER_CAP_MB=300
# Shown on /privacy as the contact address.
# CONTACT_EMAIL=

# Google Calendar (a "Web application" OAuth client in Google Cloud).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
# Encrypts stored Google tokens - long random string; don't change it later.
# GOOGLE_TOKEN_KEY=

# Backup AI when Google is overloaded (optional). Without a key nothing changes.
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=openai/gpt-6-luna,anthropic/claude-haiku-4.5
